FROM python:3.10-slim

# Set DEBIAN_FRONTEND to noninteractive to avoid prompts during apt-get install
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    ffmpeg \
    wget \
    curl \
    gcc \
    libc6-dev \
    portaudio19-dev \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV OMP_NUM_THREADS=4

# Set working directory
WORKDIR /app

# Copy requirements files
COPY services/WhisperLive/requirements/server.txt /tmp/requirements-server.txt
COPY services/WhisperLive/requirements/client.txt /tmp/requirements-client.txt

# Remove GPU-specific dependencies from server requirements
RUN sed -i '/openai-whisper/d' /tmp/requirements-server.txt || true \
    && sed -i '/onnxruntime==/d' /tmp/requirements-server.txt || true

# Ensure pip, setuptools, wheel are available (needed by PyAudio and openai-whisper builds)
RUN pip install --upgrade pip setuptools wheel

# Install CPU-specific packages (server + client deps for testing)
# Note: openai-whisper and faster-whisper not needed for remote mode (Scribe v2 / Groq)
# but kept commented for potential future local whisper use:
#   && pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu
#   && pip install --no-build-isolation openai-whisper==20240930
#   && pip install 'faster-whisper[cpu]'
RUN pip install -r /tmp/requirements-server.txt \
    && pip install -r /tmp/requirements-client.txt \
    && pip install onnxruntime \
    && pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

# Now copy the application code
COPY services/WhisperLive/ /app/

# Copy our entrypoint script
COPY services/WhisperLive/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Copy healthcheck script
COPY services/WhisperLive/healthcheck.sh /healthcheck.sh
RUN chmod +x /healthcheck.sh

# Set it as the entrypoint
ENTRYPOINT ["/entrypoint.sh"]

# Default command to run the server with faster_whisper backend on CPU  
CMD ["--port", "9090", "--backend", "faster_whisper"]

# Define the health check using the script
HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=3 CMD /healthcheck.sh 