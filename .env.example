ADMIN_API_TOKEN=change-me-to-random-string
LANGUAGE_DETECTION_SEGMENTS=10
VAD_FILTER_THRESHOLD=0.5
WHISPER_MODEL_SIZE=medium
DEVICE_TYPE=remote
WL_MAX_CLIENTS=10
BOT_IMAGE_NAME=vexa-bot:dev

# Remote Transcriber API Configuration
# Active: ElevenLabs Scribe v2
REMOTE_TRANSCRIBER_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_MODEL=scribe_v2

# Alternative: Groq Whisper Large V3 (OpenAI-compatible)
#REMOTE_TRANSCRIBER_PROVIDER=groq
#REMOTE_TRANSCRIBER_URL=https://api.groq.com/openai/v1/audio/transcriptions
#REMOTE_TRANSCRIBER_API_KEY=your-groq-api-key-here
#REMOTE_TRANSCRIBER_MODEL=whisper-large-v3
#REMOTE_TRANSCRIBER_TEMPERATURE=0

# Alternative: OpenAI Whisper
#REMOTE_TRANSCRIBER_PROVIDER=groq
#REMOTE_TRANSCRIBER_URL=https://api.openai.com/v1/audio/transcriptions
#REMOTE_TRANSCRIBER_API_KEY=your-openai-api-key-here
#REMOTE_TRANSCRIBER_MODEL=whisper-1

# Comparison script keys (used by compare_transcribers.py)
GROQ_API_KEY=your-groq-api-key-here
DEEPGRAM_API_KEY=your-deepgram-api-key-here
VEXA_API_KEY=your-vexa-api-key-here

# Voice Agent / TTS Configuration (Optional)
OPENAI_API_KEY=

# Exposed Host Ports
API_GATEWAY_HOST_PORT=8056
ADMIN_API_HOST_PORT=8057
TRANSCRIPTION_COLLECTOR_HOST_PORT=8123
POSTGRES_HOST_PORT=5438

# Local Database
REMOTE_DB=false

# Recording Storage Backend
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=vexa-access-key
MINIO_SECRET_KEY=vexa-secret-key
MINIO_BUCKET=vexa-recordings
MINIO_SECURE=false

# Recording
RECORDING_ENABLED=true

# Local backend options
LOCAL_STORAGE_DIR=/data/recordings
LOCAL_STORAGE_FSYNC=true

# WhisperLive durable recording upload cadence
WL_RECORDING_SNAPSHOT_SECONDS=20
WL_RECORDING_UPLOAD_URL=http://bot-manager:8080/internal/recordings/upload
